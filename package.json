{
  "name": "codex-rlm",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "Evidence-backed persistent research mode for Codex",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && npm run typecheck && npm run bundle",
    "build:test": "tsc -p tsconfig.json",
    "bundle": "node scripts/build-plugin.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "npm run build && npm run build:test && node --test .test-dist/test/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
